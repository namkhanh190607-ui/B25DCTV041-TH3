import React, { Component } from "react";
import HeaderClockA from "./HeaderClockA";
import ExpenseFormA from "./ExpenseFormA";
import FilterBarA from "./FilterBarA";
import ExpenseListA from "./ExpenseListA";

const INITIAL_EXPENSES = [
  { id: "1", title: "Cơm trưa sinh viên", amount: 35000, category: "Ăn uống", date: "2026-11-18" },
  { id: "2", title: "Đổ xăng xe máy", amount: 60000, category: "Đi lại", date: "2026-11-18" },
  { id: "3", title: "Mua giáo trình Lập trình Web", amount: 120000, category: "Học tập", date: "2026-11-19" },
  { id: "4", title: "Xem phim cuối tuần", amount: 90000, category: "Giải trí", date: "2026-11-19" },
];

export default class PartAApp extends Component {
  constructor(props) {
    super(props);
    this.state = {
      expenses: INITIAL_EXPENSES,
      selectedCategory: "Tất cả",
      showClock: true,
    };
  }

  getTotalExpense = (list = this.state.expenses) => {
    return list.reduce((sum, item) => sum + item.amount, 0);
  };

  componentDidMount() {
    document.title = `Tổng chi: ${this.getTotalExpense().toLocaleString("vi-VN")} đ`;
  }

  componentDidUpdate(prevProps, prevState) {
    if (prevState.expenses !== this.state.expenses) {
      document.title = `Tổng chi: ${this.getTotalExpense().toLocaleString("vi-VN")} đ`;
    }
  }

  handleAddExpense = (newExpense) => {
    this.setState((prevState) => ({
      expenses: [newExpense, ...prevState.expenses],
    }));
  };

  handleDeleteExpense = (id) => {
    this.setState((prevState) => ({
      expenses: prevState.expenses.filter((item) => item.id !== id),
    }));
  };

  handleSelectCategory = (category) => {
    this.setState({ selectedCategory: category });
  };

  toggleClock = () => {
    this.setState((prevState) => ({ showClock: !prevState.showClock }));
  };

  render() {
    const { expenses, selectedCategory, showClock } = this.state;

    const filteredExpenses =
      selectedCategory === "Tất cả"
        ? expenses
        : expenses.filter((item) => item.category === selectedCategory);

    const displayedTotal = this.getTotalExpense(filteredExpenses);

    return (
      <div className="app-wrapper">
        <div className="container">
          <header className="app-header">
            <div>
              <h1>📒 Sổ Chi Tiêu Cá Nhân (Phần A)</h1>
              <small>Xây dựng bằng Class Component</small>
            </div>
            <div className="header-right">
              {showClock && <HeaderClockA />}
              <button className="btn" onClick={this.toggleClock}>
                {showClock ? "Ẩn đồng hồ" : "Hiện đồng hồ"}
              </button>
            </div>
          </header>

          <ExpenseFormA onAddExpense={this.handleAddExpense} />

          <div className="card">
            <h2>Danh sách khoản chi</h2>
            <FilterBarA
              selectedCategory={selectedCategory}
              onSelectCategory={this.handleSelectCategory}
            />
            <ExpenseListA
              expenses={filteredExpenses}
              totalAmount={displayedTotal}
              onDeleteExpense={this.handleDeleteExpense}
            />
          </div>
        </div>
      </div>
    );
  }
}
