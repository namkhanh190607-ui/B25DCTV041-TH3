import React, { Component } from "react";

export default class ExpenseListA extends Component {
  handleDelete = (item) => {
    if (window.confirm(`Bạn có chắc muốn xóa khoản chi "${item.title}"?`)) {
      this.props.onDeleteExpense(item.id);
    }
  };

  render() {
    const { expenses, totalAmount } = this.props;

    return (
      <div>
        {expenses.length === 0 ? (
          <p>Chưa có khoản chi nào phù hợp.</p>
        ) : (
          <table className="expense-table">
            <thead>
              <tr>
                <th>Nội dung</th>
                <th>Loại</th>
                <th>Ngày chi</th>
                <th>Số tiền</th>
                <th>Hành động</th>
              </tr>
            </thead>
            <tbody>
              {expenses.map((item) => (
                <tr key={item.id}>
                  <td>{item.title}</td>
                  <td>
                    <span className="badge-cat">{item.category}</span>
                  </td>
                  <td>{item.date}</td>
                  <td className="amount-cell">
                    {item.amount.toLocaleString("vi-VN")} đ
                  </td>
                  <td>
                    <button
                      className="btn btn-danger"
                      onClick={() => this.handleDelete(item)}
                    >
                      Xóa
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        <div className="total-row">
          <span>Tổng tiền hiển thị:</span>
          <span className="amount-cell">
            {totalAmount.toLocaleString("vi-VN")} đ
          </span>
        </div>
      </div>
    );
  }
}
